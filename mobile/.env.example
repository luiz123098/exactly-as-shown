# Copy to .env.local (ignored by git). Only public values go here — never the
# service_role key or the database password.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google Sign-In (public OAuth client IDs from Google Cloud). Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
